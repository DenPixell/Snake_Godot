const WALL := ["#.#.#", ".#.#.", "#.#.#", ".#.#.", "#.#.#"]

## Какие сегменты горят у цифр 0–9. Порядок: a b c d e f g.
const SEGMENTS := [
	"1111110", "0110000", "1101101", "1111001", "0110011",
	"1011011", "1011111", "1110000", "1111111", "1111011",
]
const SEGMENT_WIDTH := 5
const SEGMENT_HEIGHT := 9


## scale — во сколько раз увеличить каждый пиксель узора.
static func draw_pattern(canvas: CanvasItem, pattern: Array, origin: Vector2i, color: Color,
		scale := 1) -> void:
	for y in pattern.size():
		var row: String = pattern[y]
		for x in row.length():
			if row[x] == "#":
				canvas.draw_rect(Rect2(origin + Vector2i(x, y) * scale, Vector2.ONE * scale), color)


## Строка шрифтом 5 × 7 с промежутком в 1 пиксель.
static func draw_text(canvas: CanvasItem, text: String, origin: Vector2i, color := INK,
		scale := 1) -> void:
	var x := origin.x
	for ch in text.to_upper():
		ch = SAME_AS_LATIN.get(ch, ch)
		if FONT.has(ch):
			draw_pattern(canvas, FONT[ch], Vector2i(x, origin.y), color, scale)
		x += (GLYPH_WIDTH + 1) * scale


static func text_width(text: String, scale := 1) -> int:
	return maxi(text.length() * (GLYPH_WIDTH + 1) - 1, 0) * scale


static func draw_tiny(canvas: CanvasItem, text: String, origin: Vector2i, color := INK) -> void:
	var x := origin.x
	for ch in text:
		draw_pattern(canvas, TINY[ch], Vector2i(x, origin.y), color)
		x += 4


## Число семисегментными цифрами. Все сегменты всегда видны как «призрак»,
## горят только нужные — как на калькуляторе.
static func draw_number(canvas: CanvasItem, value: int, digits: int, origin: Vector2i,
		lit := true) -> void:
	var text := str(clampi(value, 0, int(pow(10, digits)) - 1)).pad_zeros(digits)
	for i in digits:
		var at := origin + Vector2i(i * (SEGMENT_WIDTH + 2), 0)
		_draw_segments(canvas, "1111111", at, GHOST)
		if lit:
			_draw_segments(canvas, SEGMENTS[int(text[i])], at, INK)


static func _draw_segments(canvas: CanvasItem, mask: String, o: Vector2i, color: Color) -> void:
	var w := SEGMENT_WIDTH - 1
	var mid := SEGMENT_HEIGHT / 2
	var h := SEGMENT_HEIGHT - 1
	var rects := [
		Rect2(o.x + 1, o.y, w - 1, 1),            # a — верх
		Rect2(o.x + w, o.y + 1, 1, mid - 1),      # b — правый верх
		Rect2(o.x + w, o.y + mid + 1, 1, mid - 1),  # c — правый низ
		Rect2(o.x + 1, o.y + h, w - 1, 1),        # d — низ
		Rect2(o.x, o.y + mid + 1, 1, mid - 1),    # e — левый низ
		Rect2(o.x, o.y + 1, 1, mid - 1),          # f — левый верх
		Rect2(o.x + 1, o.y + mid, w - 1, 1),      # g — середина
	]
	for i in 7:
		if mask[i] == "1":
			canvas.draw_rect(rects[i], color)
